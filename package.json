{
  "name": "@deepgram/ui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "web"
  ],
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "bun run --filter '@deepgram/ui' build",
    "build:registry": "bun run --filter '@deepgram/ui-registry' build",
    "build:all": "bun run --filter './packages/*' build",
    "dev": "bun run --filter '@deepgram/ui' dev",
    "typecheck": "bun run --filter '@deepgram/ui' typecheck",
    "test": "bun run --filter '@deepgram/ui' test",
    "lint": "bun run --filter '@deepgram/ui' lint",
    "build:web": "bun run --filter 'web' build"
  },
  "overrides": {
    "brace-expansion": "5.0.5",
    "@deepgram/agent": "file:../agent/packages/sdk",
    "@deepgram/react": "file:../react/packages/react"
  }
}
