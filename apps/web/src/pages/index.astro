                <button
                  onclick={`copyCmd('npx shadcn add ${REGISTRY_BASE}/${name}.json')`}
                  class="w-full flex items-center gap-2 px-3 py-2 rounded-lg font-mono text-xs text-dg-muted hover:text-dg-fog transition-colors text-left group/btn"
                  style="background:#0b0b0c; border:1px solid #2c2c33;"
                  aria-label={`Copy install command for ${name}`}>
                  <span class="text-dg-green/50 select-none">$</span>
                  <span class="flex-1 truncate">npx shadcn add {REGISTRY_BASE}/{name}.json</span>
