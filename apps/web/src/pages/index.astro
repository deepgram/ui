        ))}
      </div>
    </div>

    <!-- ══ HOW IT WORKS ══ -->
    <section class="py-28 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <p class="text-xs font-bold text-dg-green uppercase tracking-widest mb-5">REGISTRY MODEL</p>
          <h2 class="font-black tracking-tight mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
            You own the code.
          </h2>
          <p class="text-dg-muted text-base max-w-lg mx-auto">Components are copied into your project — not imported from a black box. Customize freely. No breaking updates.</p>
        </div>

        <div class="grid sm:grid-cols-3 gap-4 items-stretch">
          {[
            {
              n: '01',
              title: 'Pick a component',
              desc: 'Browse the registry. Each component is a self-contained .tsx file with Tailwind classes and Radix primitives.',
