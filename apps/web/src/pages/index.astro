          <h2 class="font-black tracking-tight mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
            Everything you need.
          </h2>
          <p class="text-dg-muted text-base max-w-xl mx-auto">
            From animated orbs to accessible mic selectors. Each component is production-ready and fully themeable.
          </p>
        </div>

        <div class="columns-1 sm:columns-2 lg:columns-3 gap-4">
          {components.map(({ name, desc, color }) => (
            <div class:list={[`gb-${color}`, 'rounded-2xl mb-4 break-inside-avoid group']}>
              <div class="rounded-2xl p-5" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">
                <div class="flex items-center justify-between mb-3">
                  <span class="font-mono text-xs text-dg-green">{name}</span>
                  <a href={`${REGISTRY_BASE}/${name}.json`} target="_blank" rel="noopener"
                     class="text-dg-pebble hover:text-dg-blue transition-colors" aria-label={`View ${name} registry JSON`}>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
