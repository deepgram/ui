---
import '../styles/global.css';

const REGISTRY_BASE = 'https://cdn.deepgram.com/ui/r';

const components = [
  { name: 'orb',                    desc: 'Animated canvas orb — idle / listening / talking states, audio-reactive',       color: 'green' },
  { name: 'voice-button',           desc: 'All-in-one voice button with 5 lifecycle states — idle, connecting, listening, speaking, error', color: 'green' },
  { name: 'agent-conversation',     desc: 'Scrollable transcript with auto-scroll and role-based bubble variants',          color: 'blue'  },
  { name: 'agent-text-input',       desc: 'Accessible text input with shadcn Textarea and send Button',                    color: 'blue'  },
  { name: 'agent-microphone-button',desc: 'Radix Toggle for mic mute/unmute with 4 states',                                color: 'blue'  },
  { name: 'agent-speaker-button',   desc: 'Radix Toggle for speaker mute/unmute',                                          color: 'blue'  },
  { name: 'agent-start-button',     desc: 'Start/stop session button — fill vs ghost based on state',                      color: 'blue'  },
  { name: 'agent-status',           desc: 'Inline status indicator reflecting agent connection state',                     color: 'subtle'},
  { name: 'mic-selector',           desc: 'Microphone device picker with permission handling — powered by Radix Select',   color: 'subtle'},
  { name: 'response',               desc: 'Lightweight markdown renderer with Tailwind Typography prose',                  color: 'subtle'},
  { name: 'bar-visualizer',         desc: 'Real-time audio frequency bar visualizer (canvas)',                             color: 'subtle'},
  { name: 'live-waveform',          desc: 'Canvas waveform driven by a volume getter function',                            color: 'subtle'},
];
---

