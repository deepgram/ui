{
  "name": "@deepgram/ui",
  "version": "0.1.4",
  "description": "Pre-built, styled React components for Deepgram Voice Agent — Tailwind v4 + shadcn tokens, fully customizable",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepgram/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/deepgram/ui/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/deepgram/ui/issues"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.styles.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@deepgram/agents": "^0.1.1",
    "@deepgram/react": "^0.1.0",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-toggle": "1.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.11.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss-scoped-preflight": "^4.0.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eventemitter3": "5.0.4",
    "happy-dom": "20.9.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.4",
    "terser": "5.46.2",
    "typescript": "6.0.2",
    "vite": "8.0.10",
    "vite-plugin-css-injected-by-js": "5.0.0",
    "vite-plugin-dts": "4.5.4"
  },
  "license": "MIT"
}
