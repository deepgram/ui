{
  "name": "@deepgram/ui",
  "version": "0.1.6",
  "description": "Pre-built, styled React components for Deepgram Voice Agent — Tailwind v4 + shadcn tokens, fully customizable",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepgram/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/deepgram/ui/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/deepgram/ui/issues"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.styles.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@deepgram/agents": "^0.1.1",
    "@deepgram/react": "^0.2.0",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-toggle": "1.1.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-scoped-preflight": "^4.0.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eventemitter3": "5.0.4",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vite-plugin-dts": "5.1.0"
  },
  "license": "MIT"
}
